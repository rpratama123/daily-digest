{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "description": "Investigates the repository and produces implementation-ready plans without changing production code.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/plan.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": "ask",
        "edit": "ask"
      }
    },
    "build": {
      "description": "Implements an approved plan, tests the changes, and reports deviations.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/build.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  }
}